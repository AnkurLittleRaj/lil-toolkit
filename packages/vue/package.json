{
  "name": "@ankurlittleraj/lil-toolkit-vue",
  "version": "0.1.0",
  "description": "vue bindings for Little Design System by Ankur",
  "license": "MIT",
  "author": "Ankur Raj",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnkurLittleRaj/lil-toolkit.git",
